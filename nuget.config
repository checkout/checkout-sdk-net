<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- No fallback folder: every package is restored into the global packages folder. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <!-- Every package comes from nuget.org only. A new source gets no package until it is mapped here. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
